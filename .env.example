# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (used in emails, QR links and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys first: sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Networking Night <boletos@networking.draftstudio.mx>"

# Signs the token inside each QR (any long random string)
TICKET_SIGNING_SECRET=

# Protects the daily keep-alive cron (any long random string; Vercel sends it automatically)
CRON_SECRET=
